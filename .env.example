APP_NAME=Moodle Guardian API
APP_VERSION=1.0.0

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/moodle_guardian

MOODLE_BASE_URL=https://aprende.uned.ac.cr/webservice/rest/server.php
MOODLE_SITE_INFO_FUNCTION=core_webservice_get_site_info
MOODLE_COURSES_FUNCTION=core_enrol_get_users_courses
MOODLE_CALENDAR_EVENTS_FUNCTION=core_calendar_get_calendar_events
MOODLE_ASSIGNMENTS_FUNCTION=mod_assign_get_assignments

TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
REQUEST_TIMEOUT_SECONDS=30

# Canal email vía Brevo (ex-Sendinblue), API HTTP: POST {BREVO_API_BASE_URL}/smtp/email
# con header `api-key`. El remitente DEBE ser un correo/dominio verificado en Brevo
# (deliverability). Vacíos hasta prender el canal; solo son OBLIGATORIOS si pedís email
# real (USE_FAKE_EMAIL=false).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CampusGuardian
BREVO_API_BASE_URL=https://api.brevo.com/v3

# Token que protege el endpoint de estado /v1/status (header X-Cron-Token).
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET_TOKEN=

# Clave Fernet para cifrar el moodle_token at-rest. OBLIGATORIA para persistir
# usuarios. Acepta varias separadas por coma para rotación (la 1ra cifra, todas
# descifran). Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

SCHEDULER_INTERVAL_HOURS=3
SCHEDULER_RUN_IMMEDIATELY_ON_START=false

# Observabilidad. SENTRY_DSN vacío => Sentry deshabilitado (no-op).
# El DSN lo obtenés al crear el proyecto en sentry.io.
SENTRY_DSN=

# Perfil de entorno (factory de implementaciones). Valores válidos: local|dev|prod.
#   local -> Moodle FAKE + notifier FAKE  (dev sin tocar servicios reales; usar DATABASE_URL de una branch dev)
#   dev   -> Moodle REAL + notifier FAKE  (probar contra Moodle real sin spamear Telegram)
#   prod  -> Moodle REAL + notifier REAL  (requiere TELEGRAM_BOT_TOKEN o la app no arranca)
# ⚠️ En prod hay que setearlo EXPLÍCITAMENTE: el default 'local' usaría fakes.
ENVIRONMENT=local

# Override del notifier real/fake, desacoplado de ENVIRONMENT. Vacío/ausente =>
# comportamiento por defecto (fake salvo en prod). USE_FAKE_NOTIFIER=false fuerza
# Telegram REAL (requiere TELEGRAM_BOT_TOKEN) aunque ENVIRONMENT=local, útil para
# probar entregas con Moodle fake sin pegarle a UNED.
# USE_FAKE_NOTIFIER=false

# Override del email real/fake, desacoplado de ENVIRONMENT. Vacío/ausente => email
# FAKE SIEMPRE (incluso en prod), porque el canal es nuevo y prod aún no tiene
# credenciales Brevo: sumar el canal no debe romper prod. USE_FAKE_EMAIL=false fuerza
# Brevo REAL y exige BREVO_API_KEY + BREVO_SENDER_EMAIL (si faltan, la app no arranca).
# USE_FAKE_EMAIL=false