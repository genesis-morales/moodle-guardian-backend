APP_NAME=Moodle Guardian API
APP_VERSION=1.0.0

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/moodle_guardian

MOODLE_BASE_URL=https://aprende.uned.ac.cr/webservice/rest/server.php
MOODLE_SITE_INFO_FUNCTION=core_webservice_get_site_info
MOODLE_COURSES_FUNCTION=core_enrol_get_users_courses
MOODLE_CALENDAR_EVENTS_FUNCTION=core_calendar_get_calendar_events
MOODLE_ASSIGNMENTS_FUNCTION=mod_assign_get_assignments

TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
REQUEST_TIMEOUT_SECONDS=30

# Token que protege el endpoint de estado /v1/status (header X-Cron-Token).
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET_TOKEN=

SCHEDULER_INTERVAL_HOURS=3
SCHEDULER_RUN_IMMEDIATELY_ON_START=false

# Observabilidad. SENTRY_DSN vacío => Sentry deshabilitado (no-op).
# El DSN lo obtenés al crear el proyecto en sentry.io.
SENTRY_DSN=
ENVIRONMENT=local